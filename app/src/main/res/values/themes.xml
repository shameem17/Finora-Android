<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Finora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/finora_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Shown while the splash screen is up; swaps to Theme.Finora afterwards. -->
    <style name="Theme.Finora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/finora_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Finora</item>
    </style>

</resources>
